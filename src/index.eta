<!doctype html>
<html lang="en" class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.site.name %> — <%= it.site.title %></title>
    <meta
      name="description"
      content="<%= it.site.description %>"
    />
    <meta name="author" content="<%= it.site.name %>" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="<%= it.site.theme_color_light %>" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="<%= it.site.theme_color_dark %>" />
    <link rel="canonical" href="<%= it.site.canonical %>" />

    <!-- Theme init: apply the persisted choice before first paint (no FOUC). -->
    <script>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= it.site.canonical %>" />
    <meta property="og:site_name" content="<%= it.site.name %>" />
    <meta property="og:title" content="<%= it.site.name %> — <%= it.site.title %>" />
    <meta
      property="og:description"
      content="<%= it.site.og_description %>"
    />
    <meta property="og:image" content="<%= it.site.canonical %><%= it.site.og_image %>" />
    <meta property="og:image:alt" content="<%= it.site.og_image_alt %>" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="<%= it.site.twitter_creator %>" />
    <meta name="twitter:title" content="<%= it.site.name %> — <%= it.site.title %>" />
    <meta
      name="twitter:description"
      content="<%= it.site.og_description %>"
    />
    <meta name="twitter:image" content="<%= it.site.canonical %><%= it.site.og_image %>" />
    <meta name="twitter:image:alt" content="<%= it.site.og_image_alt %>" />

    <link rel="icon" href="./assets/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="./assets/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="./assets/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="./assets/favicons/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Async fonts: non-render-blocking, display=optional avoids swap-induced layout shift; system fallbacks cover JS-off. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=optional"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=optional"
      />
    </noscript>
    <link rel="stylesheet" href="./assets/css/style.css" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "<%= it.site.name %>",
        "alternateName": "<%= it.site.handle %>",
        "jobTitle": "<%= it.jsonld.jobTitle %>",
        "url": "<%= it.site.canonical %>",
        "image": "<%= it.site.canonical %>assets/images/thixpin.jpg",
        "email": "mailto:<%= it.site.email %>",
        "address": { "@type": "PostalAddress", "addressLocality": "<%= it.site.location.city %>", "addressCountry": "<%= it.site.location.country_code %>" },
        "sameAs": ["<%= it.site.social.github %>", "<%= it.site.social.linkedin %>", "<%= it.site.social.kalaung %>"]
      }
    </script>
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-bg"
      >Skip to content</a
    >

    <!-- ============ Header ============ -->
    <header class="sticky top-0 z-50 border-b border-line/80 bg-bg/80 backdrop-blur supports-[backdrop-filter]:bg-bg/60">
      <div class="container-site flex h-16 items-center justify-between">
        <a href="#top" class="group flex items-center gap-2 font-mono text-sm font-medium text-ink" aria-label="<%= it.site.handle %> — back to top">
          <span class="text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">&gt;_</span><%= it.site.handle %>
        </a>

        <nav aria-label="Primary" class="hidden md:block">
          <ul class="flex items-center gap-1">
<% it.site.nav.forEach((n) => { %>
            <li><a class="nav-link" href="<%= n.href %>"><%= n.label %></a></li>
<% }) %>
            <li class="ml-2"><a class="btn-ghost px-4 py-2" href="<%= it.site.resume %>" target="_blank" rel="noopener">Résumé</a></li>
          </ul>
        </nav>

        <div class="flex items-center gap-2">
        <button
          type="button"
          id="theme-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-accent/40 hover:text-ink"
          aria-label="Toggle color theme"
        >
          <svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <button
          type="button"
          id="nav-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-ink md:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
        </div>
      </div>

      <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-line md:hidden">
        <ul class="container-site flex flex-col py-3">
<% it.site.nav.forEach((n) => { %>
          <li><a class="nav-link block" href="<%= n.href %>"><%= n.label %></a></li>
<% }) %>
          <li><a class="nav-link block" href="<%= it.site.resume %>" target="_blank" rel="noopener">Résumé ↗</a></li>
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <!-- ============ Hero ============ -->
      <section id="top" aria-labelledby="hero-title" class="relative overflow-hidden">
        <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="container-site relative grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="inline-flex items-center gap-3 rounded-full border border-line bg-surface/80 px-3 py-1.5 font-mono text-xs text-muted">
              <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
                <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
              </span>
              <span><span class="sr-only">Status: </span><%= it.site.availability %></span>
            </p>

            <h1 id="hero-title" class="mt-8 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl">
              <%= it.site.name %><span class="text-accent">.</span>
            </h1>
            <p class="mt-4 text-xl font-semibold text-ink sm:text-2xl">
              <%= it.hero.title_html %>
            </p>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
              <%= it.hero.about_html %>
            </p>

            <div class="mt-10 flex flex-wrap gap-3">
              <a class="btn-primary" href="<%= it.site.hero_ctas.primary.href %>">
                <%= it.site.hero_ctas.primary.label %>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a class="btn-ghost" href="<%= it.site.hero_ctas.secondary.href %>"><%= it.site.hero_ctas.secondary.label %></a>
            </div>

            <dl class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6">
<% it.site.proof_strip.forEach((p) => { %>
              <div>
                <dt class="font-mono text-xs uppercase tracking-wider text-muted"><%= p.label %></dt>
                <dd class="mt-1 text-2xl font-bold text-ink"><%= p.value %></dd>
              </div>
<% }) %>
            </dl>
          </div>

          <figure class="mx-auto w-56 sm:w-64 lg:w-72">
            <div class="rounded-2xl border border-line bg-surface p-2 transition duration-300 hover:border-accent/40 hover:shadow-glow">
              <img
                src="<%= it.site.photo %>"
                alt="<%= it.site.photo_alt %>"
                width="640"
                height="640"
                class="aspect-square w-full rounded-xl object-cover grayscale transition duration-500 hover:grayscale-0"
                fetchpriority="high"
              />
            </div>
            <figcaption class="mt-3 text-center font-mono text-xs text-muted">@<%= it.site.handle %> · <%= it.site.location.city %>, <%= it.site.location.country_code %></figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ Capabilities ============ -->
      <section id="capabilities" aria-labelledby="capabilities-title" class="section">
        <div class="container-site">
          <p class="eyebrow">01 / Capabilities</p>
          <h2 id="capabilities-title" class="section-title"><%= it.capabilities.heading %></h2>
          <p class="mt-4 max-w-2xl text-muted">
            <%= it.capabilities.intro %>
          </p>

          <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
<% it.capabilities.items.forEach((c) => { %>
            <li class="card card-interactive">
              <h3 class="text-lg font-semibold text-ink"><%= c.title %></h3>
              <p class="mt-2 text-sm leading-relaxed text-muted"><%= c.description %></p>
              <p class="mt-4 flex flex-wrap gap-2"><% c.tags.forEach((t, ti) => { %><span class="tag<%= ti === 0 ? ' tag-accent' : '' %>"><%= t %></span><% }) %></p>
            </li>
<% }) %>
          </ul>
        </div>
      </section>

      <!-- ============ Projects ============ -->
      <section id="projects" aria-labelledby="projects-title" class="section">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">02 / Projects</p>
              <h2 id="projects-title" class="section-title"><%= it.projects.heading %></h2>
            </div>
            <a class="btn-ghost" href="<%= it.projects.all_repos_url %>" target="_blank" rel="noopener">
              All repositories ↗
            </a>
          </div>
          <p id="repo-status" class="mt-4 font-mono text-xs text-muted"><%= it.projects.status_line %></p>

          <!-- Repo stats are fetched from the GitHub API at build time (build/render.mjs); no browser API calls. -->
          <ul id="repo-grid" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
<% it.projects.repos.forEach((r) => { %>
            <li class="card card-interactive relative flex flex-col">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-mono text-base font-medium text-ink">
                  <a class="after:absolute after:inset-0 after:rounded-xl" href="<%= r.url %>" target="_blank" rel="noopener"><%= r.name %></a>
                </h3>
<% if (r.badge) { %>
                <span class="tag tag-accent shrink-0"><%= r.badge %></span>
<% } %>
              </div>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted"><%= r.description %></p>
<% if (r.topics && r.topics.length) { %>
              <p class="mt-4 flex flex-wrap gap-2"><% r.topics.slice(0, 3).forEach((t) => { %><span class="tag"><%= t %></span><% }) %></p>
<% } %>
              <p class="mt-6 flex items-center gap-4 font-mono text-xs text-muted">
                <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full <%= r.language_accent ? 'bg-accent' : 'bg-muted' %>" aria-hidden="true"></span><span><%= r.language %></span></span>
                <span class="inline-flex items-center gap-1" aria-label="Stars"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z" /></svg><span><%= r.stars %></span></span>
<% if (r.forks !== undefined && r.forks !== null) { %>
                <span class="inline-flex items-center gap-1" aria-label="Forks"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2" /><circle cx="18" cy="5" r="2.2" /><circle cx="12" cy="19" r="2.2" /><path d="M6 7v2a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4V7M12 13v4" /></svg><span><%= r.forks %></span></span>
<% } %>
<% if (r.homepage) { %>
                <a class="relative z-10 inline-flex items-center gap-1 hover:text-accent" href="<%= r.homepage %>" target="_blank" rel="noopener">Live ↗</a>
<% } %>
              </p>
            </li>
<% }) %>
          </ul>

          <h3 class="mt-16 font-mono text-xs uppercase tracking-[0.2em] text-muted"><%= it.projects.client_heading %></h3>
          <ul class="mt-4 grid gap-4 md:grid-cols-2" role="list">
<% it.projects.client.forEach((c) => { %>
            <li class="card card-interactive">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="text-lg font-semibold text-ink"><a class="hover:text-accent" href="<%= c.url %>" target="_blank" rel="noopener"><%= c.name %> ↗</a></h4>
                <span class="font-mono text-xs text-muted"><%= c.kind %></span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted"><%= c.description %></p>
              <p class="mt-4 flex flex-wrap gap-2"><% c.tags.forEach((t, ti) => { %><span class="tag<%= ti === 0 ? ' tag-accent' : '' %>"><%= t %></span><% }) %></p>
            </li>
<% }) %>
          </ul>
        </div>
      </section>

      <!-- ============ Experience ============ -->
      <section id="experience" aria-labelledby="experience-title" class="section">
        <div class="container-site">
          <p class="eyebrow">03 / Experience</p>
          <h2 id="experience-title" class="section-title"><%= it.experience.heading %></h2>
          <!-- Roles and dates mirror assets/resume.pdf (FR-009). -->
          <ol class="mt-12 space-y-10 border-l border-line pl-7" role="list">
<% it.experience.entries.forEach((e, ei) => { %>
            <li class="relative">
              <span class="absolute -left-[33px] top-1.5 h-2.5 w-2.5 rounded-full <%= ei === 0 ? 'bg-accent' : 'bg-line' %>" aria-hidden="true"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold text-ink"><%= e.role %> · <%= e.org %></h3>
                <p class="font-mono text-xs text-muted"><%= e.start %> – <%= e.end %></p>
              </div>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                <%= e.summary %>
              </p>
            </li>
<% }) %>
          </ol>
        </div>
      </section>

      <!-- ============ Credentials ============ -->
      <section id="credentials" aria-labelledby="credentials-title" class="section">
        <div class="container-site">
          <p class="eyebrow">04 / Credentials</p>
          <h2 id="credentials-title" class="section-title"><%= it.credentials.heading %></h2>
          <ul class="mt-10 flex flex-wrap gap-3" role="list">
<% it.credentials.badges.forEach((b) => { %>
<% if (b.url) { %>
            <li><a class="tag <%= b.accent ? 'tag-accent px-3 py-1.5 hover:shadow-glow' : 'px-3 py-1.5 hover:border-accent/40 hover:text-ink' %>" href="<%= b.url %>" target="_blank" rel="noopener"><%= b.label %></a></li>
<% } else { %>
            <li><span class="tag<%= b.accent ? ' tag-accent' : '' %> px-3 py-1.5"><%= b.label %></span></li>
<% } %>
<% }) %>
          </ul>
          <p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted">
            <%= it.credentials.community_html %>
          </p>
        </div>
      </section>

      <!-- ============ Contact ============ -->
      <section id="contact" aria-labelledby="contact-title" class="section">
        <div class="container-site grid gap-12 lg:grid-cols-2">
          <div>
            <p class="eyebrow">05 / Contact</p>
            <h2 id="contact-title" class="section-title"><%= it.site.contact.heading %></h2>
            <p class="mt-4 max-w-md text-muted">
              <%= it.site.contact.blurb %>
            </p>

            <ul class="mt-8 space-y-3" role="list">
              <li>
                <a class="group inline-flex items-center gap-3 text-ink hover:text-accent" href="mailto:<%= it.site.email %>">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-surface group-hover:border-accent/40" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
                  </span>
                  <span class="font-mono text-sm"><%= it.site.email %></span>
                </a>
              </li>
              <li>
                <a class="group inline-flex items-center gap-3 text-ink hover:text-accent" href="<%= it.site.social.github %>" target="_blank" rel="noopener">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-surface group-hover:border-accent/40" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
                  </span>
                  <span class="font-mono text-sm">github.com/<%= it.site.handle %></span>
                </a>
              </li>
              <li>
                <a class="group inline-flex items-center gap-3 text-ink hover:text-accent" href="<%= it.site.social.linkedin %>" target="_blank" rel="noopener">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-surface group-hover:border-accent/40" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
                  </span>
                  <span class="font-mono text-sm">linkedin.com/in/<%= it.site.handle %></span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Web3Forms backend; the access key is injected from an Actions secret at deploy time (T019). JS falls back to mailto if the POST fails. -->
          <form
            id="contact-form"
            class="card space-y-5"
            method="POST"
            action="<%= it.site.contact.form.action %>"
            data-mailto="<%= it.site.email %>"
            novalidate
          >
            <input type="hidden" name="access_key" value="" />
            <input type="hidden" name="subject" value="<%= it.site.contact.form.subject %>" />
            <input type="hidden" name="from_name" value="<%= it.site.contact.form.from_name %>" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />
            <div>
              <label for="cf-name" class="text-sm font-medium text-ink">Name</label>
              <input id="cf-name" name="name" type="text" class="field" autocomplete="name" required />
            </div>
            <div>
              <label for="cf-email" class="text-sm font-medium text-ink">Email</label>
              <input id="cf-email" name="email" type="email" class="field" autocomplete="email" required />
            </div>
            <div>
              <label for="cf-message" class="text-sm font-medium text-ink">Message</label>
              <textarea id="cf-message" name="message" rows="5" class="field resize-y" required></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn-primary">Send message</button>
              <p id="cf-status" class="text-sm text-muted" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <!-- ============ Footer ============ -->
    <footer class="border-t border-line">
      <div class="container-site flex flex-col items-center justify-between gap-4 py-8 text-sm text-muted sm:flex-row">
        <p>© <span id="year"><%= it.year %></span> <%= it.site.name %>. <%= it.site.footer.credit %></p>
        <p class="font-mono text-xs">
          <a class="hover:text-accent" href="<%= it.site.footer.source_url %>" target="_blank" rel="noopener">source ↗</a>
          <span aria-hidden="true" class="mx-2 text-line">/</span>
          <a class="hover:text-accent" href="#top">back to top ↑</a>
        </p>
      </div>
    </footer>

    <script>
      (() => {
        'use strict';

        // ---- Mobile navigation ----
        const toggle = document.getElementById('nav-toggle');
        const mobileNav = document.getElementById('mobile-nav');
        const setMenu = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          mobileNav.classList.toggle('hidden', !open);
        };
        toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
        mobileNav.addEventListener('click', (e) => e.target.closest('a') && setMenu(false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenu(false);
            toggle.focus();
          }
        });

        // ---- Active section highlighting ----
        const navLinks = [...document.querySelectorAll('.nav-link[href^="#"]')];
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const hash = `#${entry.target.id}`;
              navLinks.forEach((link) => link.setAttribute('aria-current', String(link.getAttribute('href') === hash)));
            });
          },
          { rootMargin: '-45% 0px -50% 0px' }
        );
        document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));

        document.getElementById('year').textContent = new Date().getFullYear();

        // ---- Theme toggle ----
        const themeToggle = document.getElementById('theme-toggle');
        const themeMetas = document.querySelectorAll('meta[name="theme-color"]');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        const themeColors = { dark: '<%= it.site.theme_color_dark %>', light: '<%= it.site.theme_color_light %>' };
        const effectiveTheme = () => document.documentElement.dataset.theme || (systemDark.matches ? 'dark' : 'light');
        const syncThemeUi = () => {
          themeToggle.setAttribute('aria-label', effectiveTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        };
        themeToggle.addEventListener('click', () => {
          const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          themeMetas.forEach((m) => m.setAttribute('content', themeColors[next]));
          syncThemeUi();
        });
        systemDark.addEventListener('change', syncThemeUi);
        syncThemeUi();

        // ---- Contact form ----
        const form = document.getElementById('contact-form');
        const status = document.getElementById('cf-status');
        const showStatus = (message, isError = false) => {
          status.textContent = message;
          status.classList.toggle('text-accent', isError);
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const invalid = [...form.elements].find((el) => el.willValidate && !el.checkValidity());
          form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
          if (invalid) {
            invalid.setAttribute('aria-invalid', 'true');
            invalid.focus();
            showStatus(`Please check the ${invalid.name} field.`, true);
            return;
          }

          const data = Object.fromEntries(new FormData(form));
          delete data.botcheck; // honeypot: never forward, even if a browser serializes it

          const button = form.querySelector('button[type="submit"]');
          button.disabled = true;
          showStatus('Sending…');
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(data),
            });
            if (!res.ok) throw new Error(String(res.status));
            form.reset();
            showStatus('Thanks — your message has been sent.');
          } catch {
            // POST failed: compose the same message in the visitor's mail client.
            const subject = encodeURIComponent(`Portfolio enquiry from ${data.name}`);
            const body = encodeURIComponent(`${data.message}\n\n— ${data.name} <${data.email}>`);
            window.location.href = `mailto:${form.dataset.mailto}?subject=${subject}&body=${body}`;
            showStatus('Sending failed — opening your email client instead.', true);
          } finally {
            button.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
