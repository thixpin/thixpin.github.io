{
  "name": "thixpin.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Soe Thura (@thixpin) — static HTML + Tailwind CSS v3, deployed to GitHub Pages.",
  "scripts": {
    "render": "node build/render.mjs",
    "dev": "npm run render && tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build": "npm run render && tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "eta": "^3.5.0",
    "js-yaml": "^4.1.0",
    "marked": "^16.0.0",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
